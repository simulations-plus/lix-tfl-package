<DATAFILE>

[FILEINFO]
file={path='../../../iov2_data.txt'}
delimiter = tab
header={ID, Time, Y, DOSE, EVID, TREAT, SEX, OCC}

[CONTENT]
ID = {use=identifier}
Time = {use=time}
Y = {use=observation, type=continuous}
DOSE = {use=amount}
EVID = {use=eventidentifier}
TREAT = {use=covariate, type=categorical}
SEX = {use=covariate, type=categorical}

<MODEL>

[COVARIATE]
input = {TREAT, SEX}

TREAT = {type=categorical, categories={'A', 'B'}}
SEX = {type=categorical, categories={'F', 'M'}}

[INDIVIDUAL]
input = {ka_pop, omega_ka, V_pop, omega_V, Cl_pop, omega_Cl, gamma_V, TREAT, beta_V_TREAT_B, gamma_Cl, beta_Cl_TREAT_B, gamma_ka, beta_ka_TREAT_B, corr1_V_Cl, corr2_V_Cl}

TREAT = {type=categorical, categories={'A', 'B'}}

DEFINITION:
ka = {distribution=logNormal, typical=ka_pop, covariate=TREAT, coefficient={0, beta_ka_TREAT_B}, varlevel={id, id*occ}, sd={omega_ka, gamma_ka}}
V = {distribution=logNormal, typical=V_pop, covariate=TREAT, coefficient={0, beta_V_TREAT_B}, varlevel={id, id*occ}, sd={omega_V, gamma_V}}
Cl = {distribution=logNormal, typical=Cl_pop, covariate=TREAT, coefficient={0, beta_Cl_TREAT_B}, varlevel={id, id*occ}, sd={omega_Cl, gamma_Cl}}
correlation = {level=id, r(V, Cl)=corr1_V_Cl}
correlation = {level=id*occ, r(V, Cl)=corr2_V_Cl}

[LONGITUDINAL]
input = {a, b}

file = 'lib:oral1_1cpt_kaVCl.txt'

DEFINITION:
Y = {distribution=normal, prediction=Cc, errorModel=combined1(a, b)}

<FIT>
data = 'Y'
model = Y

<PARAMETER>
Cl_pop = {value=0.05, method=MLE}
V_pop = {value=0.5, method=MLE}
a = {value=1, method=MLE}
b = {value=0.3, method=MLE}
beta_Cl_TREAT_B = {value=0, method=MLE}
beta_V_TREAT_B = {value=0, method=MLE}
beta_ka_TREAT_B = {value=0, method=MLE}
c = {value=1, method=FIXED}
corr1_V_Cl = {value=0, method=MLE}
corr2_V_Cl = {value=0, method=MLE}
gamma_Cl = {value=1, method=MLE}
gamma_V = {value=1, method=MLE}
gamma_ka = {value=1, method=MLE}
ka_pop = {value=2, method=MLE}
omega_Cl = {value=1, method=MLE}
omega_V = {value=1, method=MLE}
omega_ka = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = Linearization)
logLikelihood(method = Linearization)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = '../../'
dataandmodelnexttoproject = yes

