<DATA_FORMATTING>

[FILEINFO]
file={path='data/data_sheets_doses_first.xlsx', sheet='concentrations'}
header={ID, TIME, DV, SEX, WEIGHT}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}

[SETTINGS]
LINES:
header={0}
excluded={}

[OPERATIONS]
OBSERVATIONS:
type=id
duplicateInfo=true
censoringTags={}
'DV'={}

TREATMENTS:
occasionGeneration=false
duplicateObservationsAtDoseTimes=false
administrations={{file={path='data/data_sheets_doses_first.xlsx', sheet='doses'}}}

<DATAFILE>

[FILEINFO]
file={path='data/data_sheets_doses_first.xlsx', sheet='concentrations'}
delimiter = tab
header={ID, TIME, DV, SEX, WEIGHT, AMT}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DV = {use=observation, type=continuous}
SEX = {use=covariate, type=categorical}
WEIGHT = {use=covariate, type=continuous}
AMT = {use=amount}

<MODEL>

[COVARIATE]
input = {WEIGHT, SEX}

SEX = {type=categorical, categories={'F', 'M'}}

<PKANALIX>

[TASKS]
bioequivalence(run=false)

[SETTINGS]
NCA:
obsIdToUse = 'DV'
administrationType = {1 = extravascular}
startTimeNotBefore = {use=no, value=0}
partialAUCTime = {use=no, value={{0, 24}}}
addSteadyState = {use=no, value=24}
computedParameters = {{value = Lambda_z}, {value = Lambda_z_intercept}, {value = No_points_lambda_z}, {value = Rsq}, {value = Rsq_adjusted}, {value = Tmax}, {value = Tmax_SS}, {value = Cmax}, {value = Cmax_SS}, {value = Tlast}, {value = Clast}, {value = AUClast}, {value = AUCINF_obs}, {value = Vz_F_obs}, {value = Cl_F_obs}, {value = Vz_obs}, {value = Cl_obs}, {value = Ctau}, {value = AUC_TAU}, {value = Vz_F}, {value = CLss_F}, {value = AUC_Int, partialInt = 0}, {value = AUC_Int_D, partialInt = 0}, {value = Tmax_Rate}, {value = Max_Rate}, {value = Rate_last}, {value = AURC_last}, {value = AURC_INF_obs}, {value = AURC_Int, partialInt = 0}, {value = AURC_Int_D, partialInt = 0}}
sparseDataCensoring = {type = singlerule, rule = zero, checkMeanSamples = {no, {loq = 0, blqBeforeTmax = zero, blqAfterTmax = missing}}}

CA:
initialvalues = {}

BIOEQUIVALENCE:
computedParameters = {{value = Cmax, log = yes}, {value = AUClast, log = yes}, {value = AUCINF_obs, log = yes}, {value = Max_Rate, log = yes}, {value = AURC_last, log = yes}}
design = parallel
factors = {formulation={'SEX'}, reference={'F'}}

